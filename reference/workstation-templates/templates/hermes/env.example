# Required for Telegram-backed Hermes deployments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional channel/runtime integrations. Keep unset unless the private deployment needs them.
SIGNAL_CLI_PATH=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared local control-plane paths.
OBSIDIAN_VAULT_PATH=$HOME/.openclaw/workspace
WORKSTATION_SAFE_ROOT=$HOME/workstation-safe-root
MCP_GATEWAY_COMMAND=docker mcp gateway run --long-lived
